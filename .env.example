# F1 Knowledge System — Environment Configuration
# Copy this file to .env and fill in your values.
#
# IMPORTANT: GRAPHDB_REPOSITORY must match the repository name created by
# scripts/create_graphdb_repo.sh (default: ws-formula1-owlmax).
# The repository MUST use the owl-max-optimized ruleset for rdfs:domain
# inference to work at load time.

# Django
DJANGO_SECRET_KEY=replace-this-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# GraphDB
GRAPHDB_BASE_URL=http://localhost:7200
GRAPHDB_REPOSITORY=ws-formula1-owlmax
GRAPHDB_USERNAME=
GRAPHDB_PASSWORD=
GRAPHDB_GRAPH_URI=

# Admin panel credentials (created automatically by setup.sh)
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=admin
DJANGO_SUPERUSER_EMAIL=admin@f1.local

# Google Gemini API key (optional — only needed for the F1 Assistant page)
GEMINI_KEY=
